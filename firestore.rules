rules_version = '2';

// Fix My Problem stores everything through its own server, which authenticates
// the user and checks ownership before every read and write. No client ever
// talks to Firestore directly, so the safe rule is to deny all client access
// outright - the Admin SDK bypasses these rules by design.
//
// This file exists so that a misconfigured client SDK, or a leaked web API key,
// cannot become a way to read someone's case file.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
