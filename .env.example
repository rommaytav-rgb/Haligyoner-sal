# Copy to .env.local and adjust. Every value here is optional; the app runs with none of them.

# Where the SQLite database lives.
DATABASE_PATH=./data/app.db

# Natural-language basket parsing and generated explanations.
# Without a key the app falls back to deterministic parsing and templated text;
# no feature is lost, and no price or percentage is ever produced by the model.
# ANTHROPIC_API_KEY=

# Live price fetching from the Israeli transparency portals is OFF by default.
# Turn it on only after reviewing each portal's terms of use for your deployment
# and marking its endpoint verified in data/chains.json.
ENABLE_LIVE_PRICE_FETCH=false

# The synthetic demo dataset. Set to false for a deployment that must only ever
# show verified market prices.
DEMO_DATA=true

# Seed account created by `npm run db:seed`.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo-password-2026
