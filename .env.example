# Fix My Problem - environment configuration.
# Nothing here is read by client-side code. On Cloud Run, supply the secret
# values from Secret Manager rather than as plain environment variables.

# --- Required in production -------------------------------------------------

# Signs session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=

# --- Data -------------------------------------------------------------------

# "firestore" uses Firestore; anything else uses the local JSON store, which is
# intended for development only.
DATA_BACKEND=firestore
GOOGLE_CLOUD_PROJECT=
# Only needed outside Google Cloud; on Cloud Run, Application Default
# Credentials are used automatically.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Where the local store writes when DATA_BACKEND is not "firestore".
LOCAL_DATA_DIR=.data

# --- Evidence storage -------------------------------------------------------

# A private Cloud Storage bucket. Leave unset to store files on local disk.
# The bucket must NOT be publicly readable - files are served only through
# /api/cases/:id/evidence/:evidenceId, which re-checks ownership.
EVIDENCE_BUCKET=
MAX_UPLOAD_BYTES=10485760

# --- AI ---------------------------------------------------------------------

# Without a key the app runs on its rule-based provider and says so in the UI.
GEMINI_API_KEY=
# Or use Vertex AI with the service account's own credentials:
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_LOCATION=us-central1

GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_DEEP=gemini-2.5-pro
AI_TIMEOUT_MS=45000

# --- Research ---------------------------------------------------------------

# Google Programmable Search. Without both values, research is reported as
# not connected rather than simulated.
SEARCH_API_KEY=
SEARCH_ENGINE_ID=

# --- Limits -----------------------------------------------------------------

MAX_AGENT_ITERATIONS=6
MAX_TOOL_CALLS=12
